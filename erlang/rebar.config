{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{escript_name, raytracer}.
{escript_main_app, raytracer}.

{project_plugins, [erlfmt]}.
{erlfmt, [
    write,
    {files, ["rebar.config", "{src,include,test}/*.{erl,hrl,app.src}"]}
]}.

{dialyzer, [{warnings, [unmatched_returns, error_handling]}]}.
