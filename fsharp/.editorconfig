root = true

[*]
indent_style = space
insert_final_newline = true

[*.{fs,fsx}]
indent_size = 4
max_line_length = 100
# Keeps short records and lists, such as the vector operators' results, on
# one line.
fsharp_max_record_width = 80
fsharp_max_array_or_list_width = 80

[*.{fsproj,props,slnx,json}]
indent_size = 2
