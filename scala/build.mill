//| mill-version: 1.3.0
//| mill-jvm-version: 25
package build

import mill.*, scalalib.*

object `package` extends ScalaModule {
  def scalaVersion = "3.10.0"
  def scalacOptions = Seq("-deprecation", "-feature", "-Wunused:all", "-Werror")
  def mainClass = Some("raytracer.Main")

  object test extends ScalaTests, TestModule.Munit {
    def mvnDeps = Seq(mvn"org.scalameta::munit::1.3.6")
  }

  // Mirrors BenchmarkRender in the Go version: the test scene at 100x100 with
  // 50 samples per pixel. Usage: ./mill bench [iterations [threads]]
  def bench(args: String*) = Task.Command {
    test.runMain("raytracer.Bench", args*)()
  }
}
