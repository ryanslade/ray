{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}
 :aliases
 {;; Direct linking turns calls between functions into static method calls,
  ;; which the JIT can inline: it renders the test scene about 1.8x faster.
  :run {:jvm-opts ["-Dclojure.compiler.direct-linking=true"]
        :main-opts ["-m" "raytracer.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["-Dclojure.compiler.direct-linking=true"]
         :main-opts ["-m" "cognitect.test-runner"]}
  :bench {:extra-paths ["test" "bench"]
          :jvm-opts ["-Dclojure.compiler.direct-linking=true"]
          :main-opts ["-m" "raytracer.bench"]}
  :fmt {:deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
        :main-opts ["-m" "cljfmt.main"]}
  :lint {:deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "bench"]}}}
